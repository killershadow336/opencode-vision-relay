{
  "name": "opencode2-vision-relay",
  "version": "0.2.0",
  "type": "module",
  "description": "OpenCode V2 (opencode2) plugin: gives text-only models vision by relaying image parts to any OpenAI-compatible vision provider (Gemini, OpenAI, Groq, OpenRouter, Ollama...) and replacing them with detailed text analyses.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "GUIA.md",
    "LICENSE"
  ],
  "scripts": {
    "clean": "rm -rf dist",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepack": "npm run clean && npm run build && npm test"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "opencode",
    "opencode2",
    "plugin",
    "vision",
    "multimodal",
    "gemini",
    "openai",
    "groq",
    "ollama",
    "text-only"
  ],
  "license": "MIT",
  "dependencies": {
    "@opencode-ai/plugin": "0.0.0-next-17444"
  },
  "devDependencies": {
    "@ai-sdk/provider": "3.0.8",
    "@opencode-ai/ai": "0.0.0-next-17444",
    "@opencode-ai/schema": "0.0.0-next-17444",
    "@types/node": "^24.0.0",
    "typescript": "^5.8.0",
    "vitest": "^3.0.0"
  }
}